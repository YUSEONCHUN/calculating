# ── 권리금 도구 (forkAddon) 환경설정 ──
# cp .env.example .env 후 값을 채우세요. 이 파일은 웹에서 접근 차단됩니다.

# [DB] docker-compose 가 띄우는 MariaDB 기준 (컨테이너 내부에서는 host=db)
DB_HOST=db
DB_PORT=3306
DB_NAME=goodwill
DB_USER=goodwill
DB_PASS=goodwillpw
DB_ROOT_PASSWORD=rootpw

# [포트] 호스트에서 접근할 포트
WEB_PORT=8090
DB_PORT_HOST=3318

# [관리자 콘솔 비밀번호] — 관리자 페이지 접근
DASHBOARD_PASSWORD=change-me

# [Gemini API 키] — 권리금 계산(premium.php)의 AI 분석에 필요 (없으면 계산은 되고 AI 설명만 생략)
# https://aistudio.google.com 에서 발급
GEMINI_API_KEY=

# [카카오 REST 키] — 매물 비교의 반경 500m 약국 조회, 주소 좌표 변환 (선택)
KAKAO_REST_KEY=

# [공공데이터포털 키] — 권리금 계산의 병·의원/약국 실측 조회 (선택)
DATA_GO_KR_KEY=
