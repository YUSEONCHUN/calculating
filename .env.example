# ── 권리금 도구 환경설정 (템플릿) ──
# cp .env.example .env 후 값을 채우세요. .env 는 .gitignore 로 저장소에 올라가지 않습니다.
#
# ⚠ 아래 DB 비밀번호와 DASHBOARD_PASSWORD 는 로컬 도커용 예시값입니다.
#   외부에서 접근 가능한 환경에 올릴 때는 반드시 바꾸세요.

# [DB] docker-compose 가 띄우는 MariaDB 기준 (컨테이너 내부에서는 host=db)
DB_HOST=db
DB_PORT=3306
DB_NAME=goodwill
DB_USER=goodwill
DB_PASS=goodwillpw
DB_ROOT_PASSWORD=rootpw

# [포트] 호스트에서 접근할 포트
WEB_PORT=8090
DB_PORT_HOST=3318

# [관리자 콘솔 비밀번호] — 관리자 페이지 접근
DASHBOARD_PASSWORD=change-me

# ── 외부 API 키 (모두 선택 — 없으면 해당 기능만 생략되고 권리금 계산은 정상 동작) ──
# 발급 절차는 README 의 '키 발급 방법' 참고. 키 변경 후: docker compose restart web

# [Gemini API 키] — 권리금 계산 v3(premium.php)의 AI 분석·입력값 검증
# 발급: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# [카카오 REST 키] — 주소를 좌표로 변환해 반경 상권 조회에 연결
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# (화면의 주소 검색 버튼은 키 없이 동작합니다)
KAKAO_REST_KEY=

# [공공데이터포털 키] — 권리금 계산 v3의 병·의원 수·약국 수·상권 업소 수 조회
# 발급: https://www.data.go.kr → 병의원 찾기 / 약국 찾기 / 소상공인시장진흥공단_상가(상권)정보 활용신청
# ⚠ '일반 인증키 (Decoding)' 를 넣으세요 — Encoding 키는 이중 인코딩되어 인증 오류가 납니다
DATA_GO_KR_KEY=
